# Конфигурация LLM Second Brain — все переменные из REQUIREMENTS §8.
# Скопируй в .env и заполни: cp .env.example .env

# --- Обязательные (без умолчаний; пустые/отсутствующие — фатальная ошибка старта) ---

# Ollama-сервер векторизации
OLLAMA_BASE_URL=http://192.168.3.113:11434

# Ollama-сервер суммаризации
SUMMARY_OLLAMA_BASE_URL=http://192.168.3.112:11434

# Генеративная модель суммаризации
SUMMARY_MODEL=ornith-1.5:35b

# Bearer-токен (генерируй свой, например: openssl rand -hex 32)
MCP_AUTH_TOKEN=

# --- Необязательные (ниже — значения по умолчанию) ---

# embedding-модель векторизации
EMBEDDING_MODEL=qwen3-embedding:8b

# размерность векторов (фиксируется при создании БД; смена требует переиндексации)
EMBEDDING_DIM=4096

# лимит краткого содержания заметки
MAX_SUMMARY_CHARS=200

# длина фрагмента текста (snippet) в выдаче memory_search
SNIPPET_CHARS=120

# максимум id в одном вызове memory_get
MAX_GET_BATCH=20

# разрешить рассуждения суммаризатора (при false в вызов идёт "think": false)
SUMMARY_THINK=true

# бюджет генерации суммаризатора (общий на thinking+content)
SUMMARY_NUM_PREDICT=1500

# клиентский таймаут вызова суммаризатора, сек
SUMMARY_TIMEOUT_SEC=60

# порт HTTP-сервера (MCP, REST, /health)
PORT=8080

# путь MCP-сервера (Streamable HTTP)
MCP_PATH=/mcp

# путь к файлу SQLite
DB_PATH=/data/notes.db

# top_k по умолчанию в memory_search
DEFAULT_TOP_K=5

# limit по умолчанию в memory_list
DEFAULT_LIST_LIMIT=20

# порог косинусной близости для отсечения кандидатов поиска
SCORE_THRESHOLD=0.35

# порог «почти дубликата» в memory_save
DEDUP_SIMILARITY=0.92

# константа слияния Reciprocal Rank Fusion
RRF_K=60

# лимит длины заметки, символов
MAX_NOTE_CHARS=2000

# лимит поискового запроса, символов
MAX_QUERY_CHARS=512

# стартовый интервал фоновых до-векторизации/досуммаризации, сек
PENDING_RETRY_SEC=30

# уровень логов
LOG_LEVEL=INFO

# author заметки, если харнес не передал метаданные
AUTHOR_DEFAULT=unknown

# каталог снапшотов БД
BACKUP_DIR=/data/backups

# интервал снапшотов, сек (сутки)
BACKUP_INTERVAL_SEC=86400

# число хранимых копий (ротация)
BACKUP_KEEP=7